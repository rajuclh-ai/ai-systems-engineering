OPENAI_API_KEY=your_openai_api_key

# LangSmith observability (set TRACING_V2=false to disable)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=self-healing-pipeline-agent

# Agent config
RISK_THRESHOLD=0.7
LLM_MODEL=gpt-4o-mini

# SQLite database path
DATABASE_URL=sqlite:///incidents.db

# Flink REST API — set this to enable real RESTART execution
# Leave unset to run in simulation mode (default)
# Start Flink: cd docker && docker compose up
FLINK_REST_URL=http://localhost:8081
